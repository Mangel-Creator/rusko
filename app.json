{
  "expo": {
    "name": "Organizy",
    "slug": "organizy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "organizy",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.mangelcreator.organizy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mangelcreator.organizy",
      "adaptiveIcon": {
        "backgroundColor": "#F3EFE6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Organizy",
      "shortName": "Organizy",
      "themeColor": "#0F0D0C",
      "backgroundColor": "#0F0D0C"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0D0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Organizy usa tu ubicación para calcular el tráfico y avisarte de cuándo tienes que salir.",
          "locationAlwaysAndWhenInUsePermission": "Organizy usa tu ubicación mientras navegas para seguir dándote indicaciones por voz con el móvil bloqueado.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": "Organizy usa el micrófono solo mientras tocas el botón del micro, para apuntar lo que le dices.",
          "recordAudioAndroid": false
        }
      ],
      [
        "./plugins/alarmas.js",
        {
          "alarmKitUsageDescription": "Organizy usa alarmas para despertarte y avisarte de cuándo salir, aunque el móvil esté en silencio."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Organizy usa tu agenda solo para poner el nombre de quien elijas en un plan. No guarda ni envía tus contactos."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Organizy usa el micrófono solo mientras tocas el botón del micro, para apuntar lo que le dices.",
          "speechRecognitionPermission": "Organizy pasa a texto lo que le dices para apuntarlo en tu agenda."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/organizy"
    },
    "backgroundColor": "#0F0D0C",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf4c1bdd-dea3-4040-b236-458205d44d0e"
      }
    },
    "owner": "mangel_creator"
  }
}
